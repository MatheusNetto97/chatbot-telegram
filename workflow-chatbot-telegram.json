      "id": "climabot-2",
      "name": "Capturar entrada",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const { rawText = '', chatId } = $json;\nconst stateNames = {\n  AC: 'Acre', AL: 'Alagoas', AP: 'Amapá', AM: 'Amazonas', BA: 'Bahia',\n  CE: 'Ceará', DF: 'Distrito Federal', ES: 'Espírito Santo', GO: 'Goiás',\n  MA: 'Maranhão', MT: 'Mato Grosso', MS: 'Mato Grosso do Sul', MG: 'Minas Gerais',\n  PA: 'Pará', PB: 'Paraíba', PR: 'Paraná', PE: 'Pernambuco', PI: 'Piauí',\n  RJ: 'Rio de Janeiro', RN: 'Rio Grande do Norte', RS: 'Rio Grande do Sul',\n  RO: 'Rondônia', RR: 'Roraima', SC: 'Santa Catarina', SP: 'São Paulo',\n  SE: 'Sergipe', TO: 'Tocantins',\n};\nconst normalizeText = text => text.normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase();\nconst cleanText = String(rawText).trim().replace(/\\s+/g, ' ');\nconst parts = cleanText.split(',').map(part => part.trim());\nconst [cityName = '', state = '', country = ''] = parts;\nconst stateCode = state.toUpperCase();\nconst inputValid = parts.length === 3\n  && cityName.length > 0 && cityName.length <= 120\n  && /^[\\p{L}][\\p{L}\\p{M} .’'\\-]*$/u.test(cityName)\n  && Object.hasOwn(stateNames, stateCode)\n  && country.toUpperCase() === 'BR';\nconst isHelp = /^\\/(start|help|ajuda)(@\\w+)?$/i.test(cleanText);\nconst message = isHelp\n  ? 'Olá! Envie uma cidade no formato Cidade,UF,BR. Exemplo: São Paulo,SP,BR.'\n  : '❌ Cidade não encontrada. Use o formato Cidade,UF,BR (ex.: São Paulo,SP,BR).';\nreturn { json: {\n  chatId, cityName, stateCode, stateName: stateNames[stateCode] || '',\n  queue: normalizeText(parts.join(',')), inputValid, message,\n} };"
      },
