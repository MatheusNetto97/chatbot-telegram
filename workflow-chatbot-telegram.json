    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const location = $('Selecionar cidade').item.json;\nconst { statusCode, body } = $json;\nconst temperature = body?.main?.temp;\nconst coordinatesMatch = typeof body?.coord?.lat === 'number'\n  && typeof body?.coord?.lon === 'number'\n  && Math.abs(body.coord.lat - location.latitude) <= 0.02\n  && Math.abs(body.coord.lon - location.longitude) <= 0.02;\nconst responseValid = statusCode === 200 && Number(body?.cod) === 200\n  && typeof body?.name === 'string' && body.name.trim().length > 0\n  && typeof temperature === 'number' && Number.isFinite(temperature)\n  && body?.sys?.country === 'BR' && coordinatesMatch;\nlet message = '⚠️ O serviço de clima está indisponível no momento. Tente novamente em alguns minutos.';\nif (statusCode === 200 || statusCode === 404) {\n  message = '❌ Cidade não encontrada. Use o formato Cidade,UF,BR (ex.: São Paulo,SP,BR).';\n}\nif (responseValid) {\n  const roundedTemperature = Math.round(temperature);\n  message = `🌤️ A temperatura em ${location.displayCityName} é de ${roundedTemperature}°C.`;\n}\nreturn { json: { chatId: location.chatId, responseValid, message } };"
      },
