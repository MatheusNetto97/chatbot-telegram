    {
      "parameters": {
        "method": "GET",
        "url": "https://api.openweathermap.org/geo/1.0/direct",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $json.queue.split(',')[0] + ',br' }}"
