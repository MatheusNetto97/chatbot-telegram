      "id": "climabot-5",
      "name": "Buscar localidade",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        -140
      ],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const request = $('Normalizar entrada').item.json;\nconst { statusCode, body } = $json;\nconst unavailable = '⚠️ O serviço de clima está indisponível no momento. Tente novamente em alguns minutos.';\nconst notFound = '❌ Cidade não encontrada. Use o formato Cidade,UF,BR (ex.: São Paulo,SP,BR).';\nconst normalizeText = text => String(text || '').normalize('NFD')\n  .replace(/[\\u0300-\\u036f]/g, '').trim().replace(/\\s+/g, ' ').toLowerCase();\nconst candidates = statusCode === 200 && Array.isArray(body) ? body : [];\nconst matches = candidates.filter(candidate => {\n  if (!candidate || typeof candidate !== 'object') return false;\n  const cityNames = [candidate.name, candidate.local_names?.pt];\n  return candidate.country === 'BR'\n    && normalizeText(candidate.state) === normalizeText(request.stateName)\n    && cityNames.some(name => normalizeText(name) === normalizeText(request.cityName))\n    && typeof candidate.lat === 'number' && Number.isFinite(candidate.lat)\n    && typeof candidate.lon === 'number' && Number.isFinite(candidate.lon)\n    && Math.abs(candidate.lat) <= 90 && Math.abs(candidate.lon) <= 180;\n});\nconst localizedMatches = matches.filter(candidate =>\n  normalizeText(candidate.local_names?.pt) === normalizeText(request.cityName));\nconst preferredMatches = localizedMatches.length > 0 ? localizedMatches : matches;\nconst locationFound = preferredMatches.length === 1;\nconst selected = locationFound ? preferredMatches[0] : null;\nreturn { json: {\n  ...request, locationFound,\n  latitude: selected?.lat ?? null, longitude: selected?.lon ?? null,\n  displayCityName: selected?.local_names?.pt || selected?.name || request.cityName,\n  message: statusCode === 200 || statusCode === 404 ? notFound : unavailable,\n} };"
      },
