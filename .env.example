# Copie para .env. Nunca publique o arquivo .env.
OPENWEATHER_API_KEY=
# Referência de configuração. Cadastre o valor no cofre Telegram API do n8n.
# Esta variável NÃO cria a credencial Telegram automaticamente.
TELEGRAM_BOT_TOKEN=
# Gere uma chave única: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_ENCRYPTION_KEY=
# Gere outro valor aleatório; compartilhado apenas entre n8n e task-runners.
N8N_RUNNERS_AUTH_TOKEN=
# Endereço provisório para cadastrar o proprietário antes de abrir o túnel.
# Substitua pelo HTTPS real do ngrok antes de testar o Telegram.
WEBHOOK_URL=https://example.invalid/
